# Supabase-project (Project Settings → API). De anon key is publiek; RLS beschermt de data.
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Alleen in Netlify: build hook voor de knop "Site publiceren" (Site configuration → Build hooks)
NETLIFY_BUILD_HOOK_URL=

# Alleen lokaal, voor scripts/migrate-content.mjs. NOOIT in Netlify of in git.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
