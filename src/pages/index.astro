---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ToolTable from '../components/ToolTable.astro';
import Figure from '../components/Figure.astro';
import { getProjects, getTools, getProjectCategories } from '../lib/content';

const projects = await getProjects();
const tools = await getTools();
const recent = projects.slice(0, 3);
const featured = projects.find((p) => p.image);
const counts = (await getProjectCategories()).map((cat) => ({
  cat,
  n: projects.filter((p) => p.category === cat).length,
}));
---

<Base title="Home" image={featured?.image?.src}>
  <section class="container hero">
    <div class="hero-text">
      <div class="kicker">Blad 01 · Maker uit Rotterdam</div>
      <h1>Ik maak dingen<br />die er <em>toe doen</em></h1>
      <p class="lead">
        3D printen, CNC-frezen, houtbewerking en miniaturen — van digitaal ontwerp tot tastbaar object.
      </p>
      <div class="cta">
        <a href="/projecten" class="btn">Bekijk projecten →</a>
        <a href="/over" class="btn btn-ghost">Over mij</a>
      </div>
    </div>

    {featured && (
      <a href={`/projecten/${featured.id}`} class="hero-fig">
        <Figure
          image={featured.image}
          alt={featured.title}
          caption={`Fig. 1 — ${featured.nr} ${featured.title}`}
          size="tile"
          dimensions={featured.dimensions}
          eager
        />
      </a>
    )}
  </section>

  <section class="container" aria-label="Werkgebieden">
    <div class="legend">
      <div class="cell">
        <div class="label">Legenda</div>
        <div class="name">Werkgebieden</div>
      </div>
      {counts.map(({ cat, n }, i) => (
        <a class="cell" href={`/projecten?categorie=${encodeURIComponent(cat)}`}>
          <div class="label">{String(i + 1).padStart(2, '0')} — {n} {n === 1 ? 'project' : 'projecten'}</div>
          <div class="name">{cat}</div>
        </a>
      ))}
    </div>
  </section>

  <section class="container section">
    <div class="section-head">
      <h2>Recente onderdelen</h2>
      <a href="/projecten" class="mono more">Alle {projects.length} projecten →</a>
    </div>
    <div class="tile-grid">
      {recent.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section class="container section">
    <div class="section-head bare">
      <h2>Stuklijst</h2>
      <span class="label">Machines in de werkplaats</span>
    </div>
    <ToolTable tools={tools} />
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 72px;
    align-items: center;
    padding-top: 88px;
    padding-bottom: 96px;
  }
  h1 { margin-top: 28px; font-size: clamp(3.2rem, 7.5vw, 5.6rem); line-height: 0.98; }
  .lead { max-width: 520px; margin-top: 28px; font-size: 19px; }
  .cta { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 40px; }
  .hero-fig { display: block; color: inherit; }

  .legend {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--rule);
    background: var(--panel);
  }
  .legend .cell { display: block; padding: 22px 24px; border-right: 1px solid var(--rule); color: var(--ink); }
  .legend .cell:last-child { border-right: 0; }
  .legend a.cell:hover .name { color: var(--mark); }
  .legend .label { text-transform: none; letter-spacing: 0.06em; }
  .legend .name { margin-top: 6px; font-family: var(--font-display); font-size: 21px; line-height: 1.2; }

  .section-head.bare { border-bottom: 0; }
  .more { font-size: 14px; padding: 12px 0; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr); gap: 48px; padding-top: 48px; padding-bottom: 64px; }
    .legend { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .legend .cell:nth-child(2) { border-right: 0; }
    .legend .cell:nth-child(-n + 2) { border-bottom: 1px solid var(--rule); }
  }
</style>
