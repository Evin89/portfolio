---
import { render, getEntries } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import TitleBlock from '../../components/TitleBlock.astro';
import { getProjects, existingImage, formatMonth, type Project } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    // lijst is nieuwste eerst: "vorig" is ouder (i + 1), "volgend" is nieuwer (i - 1)
    props: { project, prev: projects[i + 1], next: projects[i - 1] },
  }));
}

interface Props {
  project: Project;
  prev?: Project;
  next?: Project;
}

const { project, prev, next } = Astro.props;
const { title, category, description, date, tags, image, gallery, machine, dimensions } = project.data;
const { Content } = await render(project);
const usedTools = await getEntries(project.data.tools);
const cover = existingImage(image);
const extra = gallery.map((g) => existingImage(g)).filter((g): g is string => Boolean(g));
---

<Base title={title} description={description} image={cover}>
  <div class="container">
    <nav class="crumbs mono" aria-label="Kruimelpad">
      <a href="/projecten">Projecten</a>
      <span aria-hidden="true">/</span>
      <a href={`/projecten?categorie=${encodeURIComponent(category)}`}>{category}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{project.nr}</span>
    </nav>

    <header class="intro">
      <div class="nr mono">Onderdeel {project.nr}</div>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
    </header>

    <section class="split">
      <Figure src={cover} alt={title} caption="Fig. 1 — Overzicht" size="tile-l" dimensions={dimensions} eager />
      <TitleBlock
        rows={[
          { label: 'Nummer', value: project.nr, accent: true },
          { label: 'Categorie', value: category, href: `/projecten?categorie=${encodeURIComponent(category)}` },
          { label: 'Datum', value: formatMonth(date) },
          { label: 'Machine', value: machine },
        ]}
        tags={tags}
        links={usedTools.map((t) => ({ label: t.data.name, href: `/tools/${t.id}` }))}
      />
    </section>

    <section class="body">
      <article class="prose">
        <Content />
      </article>
      {extra.length > 0 && (
        <div class="gallery">
          {extra.map((src, i) => (
            <Figure src={src} alt={`${title}, detail ${i + 1}`} caption={`Fig. ${i + 2} — Detail`} size="tile" />
          ))}
        </div>
      )}
    </section>

    <nav class="pager" aria-label="Andere projecten">
      {prev ? (
        <a href={`/projecten/${prev.id}`}>
          <span class="label">← Vorig · {prev.nr}</span>
          <span class="t">{prev.data.title}</span>
        </a>
      ) : <span />}
      {next && (
        <a href={`/projecten/${next.id}`} class="right">
          <span class="label">Volgend · {next.nr} →</span>
          <span class="t">{next.data.title}</span>
        </a>
      )}
    </nav>
  </div>
</Base>

<style>
  .crumbs { padding-top: 28px; font-size: 13px; color: var(--muted); display: flex; flex-wrap: wrap; gap: 8px; }
  .crumbs a { color: var(--muted); }
  .crumbs a:hover { color: var(--mark); }
  .crumbs [aria-current] { color: var(--ink); }

  .intro { padding: 40px 0 48px; }
  .nr { font-size: 13px; letter-spacing: 0.14em; color: var(--mark); }
  h1 { margin-top: 14px; font-size: clamp(3.2rem, 8vw, 6rem); line-height: 0.95; }
  .lead { max-width: 640px; margin-top: 22px; font-size: 20px; }

  .split {
    display: grid;
    grid-template-columns: auto minmax(280px, 1fr);
    gap: 56px;
    align-items: start;
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 56px;
    padding-top: 88px;
  }
  .gallery { display: flex; flex-direction: column; gap: 40px; }

  .pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    margin-top: 112px;
    padding: 28px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .pager a { display: flex; flex-direction: column; gap: 4px; padding: 4px 0; color: var(--ink); }
  .pager a.right { text-align: right; margin-left: auto; }
  .pager .t { font-family: var(--font-display); font-size: 26px; }
  .pager a:hover .t { color: var(--mark); }

  @media (max-width: 1100px) {
    .split, .body { grid-template-columns: minmax(0, 1fr); }
  }
</style>
