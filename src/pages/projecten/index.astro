---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, getProjectCategories } from '../../lib/content';

const projects = await getProjects();
const categories = (await getProjectCategories()).filter((c) => projects.some((p) => p.category === c));
---

<Base title="Projecten" description="Alle maker-projecten van Evin — 3D printen, CNC, houtbewerking en miniaturen.">
  <section class="container head">
    <div class="kicker">Blad 02 · Onderdelenregister</div>
    <div class="title-row">
      <h1>Projecten</h1>
      <span class="label count" id="count">{projects.length} onderdelen</span>
    </div>

    <div class="filters" role="group" aria-label="Filter op categorie">
      <button type="button" class="filter" data-filter="all" aria-pressed="true">Alle</button>
      {categories.map((cat) => (
        <button type="button" class="filter" data-filter={cat} aria-pressed="false">{cat}</button>
      ))}
    </div>
  </section>

  <section class="container">
    <div class="tile-grid" id="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</Base>

<style>
  .head { padding-top: 72px; }
  .title-row { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 16px; margin-top: 20px; }
  .count { font-size: 14px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 36px; padding-bottom: 28px; border-bottom: 1px solid var(--rule); }
  .filter {
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .filter:hover { border-color: var(--mark); color: var(--mark); }
  .filter[aria-pressed='true'] { background: var(--mark); border-color: var(--mark); color: var(--on-mark); }
  :global(.card[hidden]) { display: none; }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const cards = document.querySelectorAll<HTMLElement>('#grid .card');
  const count = document.getElementById('count');

  function apply(filter: string) {
    let shown = 0;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
    cards.forEach((c) => {
      const show = filter === 'all' || c.dataset.category === filter;
      c.hidden = !show;
      if (show) shown++;
    });
    if (count) count.textContent = `${shown} ${shown === 1 ? 'onderdeel' : 'onderdelen'}`;
    const url = new URL(location.href);
    if (filter === 'all') url.searchParams.delete('categorie');
    else url.searchParams.set('categorie', filter);
    history.replaceState(null, '', url);
  }

  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter ?? 'all')));

  const initial = new URLSearchParams(location.search).get('categorie');
  if (initial && [...buttons].some((b) => b.dataset.filter === initial)) apply(initial);
</script>
