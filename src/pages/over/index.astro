---
import Base from '../../layouts/Base.astro';

const machines = [
  { name: 'Bambu Lab P1S', tag: '3D' },
  { name: 'Elegoo Mars 3 Pro', tag: '3D' },
  { name: 'TwoTrees TTC 450 Pro', tag: 'CNC' },
  { name: 'Dewalt 7485 Tafelzaag', tag: 'Hout' },
  { name: 'HiKOKI C8FSHGWAZ', tag: 'Hout' },
  { name: 'Recordpower Sabre 250 Lintzaag', tag: 'Hout' },
  { name: '8" Vlak-/vandiktebank', tag: 'Hout' },
  { name: 'Bosch PBD40 Kolomboor', tag: 'Hout' },
  { name: 'Makita RTC0700 Router', tag: 'Hout' },
];

const skills = [
  'Fusion 360', 'FDM Printing', 'Resin Casting', 'CNC Routing',
  'Epoxy Inlay', 'Kitbashing', 'Houtbewerking', 'Python', 'Necromunda',
];
---

<Base title="Over" description="Over Evin — maker uit Rotterdam: 3D printen, CNC, houtbewerking en miniaturen.">
  <div class="container grid">
    <div class="body">
      <div class="kicker">Blad 04 · Over de maker</div>
      <h1>Over mij</h1>

      <div class="prose">
        <p>
          Ik ben een maker uit Rotterdam met een brede interesse in het snijvlak van
          digitaal ontwerp en fysieke fabricage. Van 3D printen en CNC-frezen tot houtbewerking
          en tabletop hobby — ik maak het liefst dingen die zowel functioneel als mooi zijn.
        </p>
        <p>
          Mijn werkplaats is uitgerust met een uitgebreide machine-setup die mij in staat stelt
          om vrijwel elk materiaal te bewerken: kunststof, hout, resin en meer.
        </p>
        <p>
          Naast het pure maken ben ik ook gefascineerd door het proces zelf — parametrisch
          ontwerpen, materiaalonderzoek, en het verfijnen van workflows. Dit portfolio is een
          levend document van wat ik maak en leer.
        </p>
      </div>

      <div class="skills">
        <div class="label">Vaardigheden</div>
        <div class="chips">{skills.map((s) => <span class="chip">{s}</span>)}</div>
      </div>
    </div>

    <aside class="park" aria-labelledby="park-title">
      <div class="park-head">
        <span id="park-title" class="park-title">Machinepark</span>
        <span class="label">{machines.length} st.</span>
      </div>
      <ol>
        {machines.map((m, i) => (
          <li>
            <span class="pos mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="name">{m.name}</span>
            <span class="tag mono">{m.tag}</span>
          </li>
        ))}
      </ol>
    </aside>
  </div>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    gap: 72px;
    align-items: start;
    padding-top: 72px;
  }
  h1 { margin-top: 20px; margin-bottom: 40px; }
  .prose p { font-size: 18px; }
  .skills { margin-top: 56px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }

  .park { border: 2px solid var(--ink); background: var(--panel); }
  .park-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 16px 20px;
    border-bottom: 2px solid var(--ink);
  }
  .park-title { font-family: var(--font-display); font-size: 22px; }
  ol { list-style: none; }
  li {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: baseline;
    padding: 12px 20px;
    border-bottom: 1px solid var(--rule);
    font-size: 15px;
  }
  li:last-child { border-bottom: 0; }
  .pos { font-size: 12px; color: var(--mark); }
  .tag { font-size: 11px; color: var(--muted); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: 56px; padding-top: 48px; }
  }
</style>
