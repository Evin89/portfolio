---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import TitleBlock from '../../components/TitleBlock.astro';
import { getTools, getProjects, existingImage, type Tool } from '../../lib/content';

export async function getStaticPaths() {
  const tools = await getTools();
  return tools.map((tool) => ({ params: { slug: tool.id }, props: { tool } }));
}

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const { name, category, description, tags, image } = tool.data;
const { Content } = await render(tool);
const usedIn = (await getProjects()).filter((p) => p.data.tools.some((t) => t.id === tool.id));
const src = existingImage(image);
---

<Base title={name} description={description} image={src}>
  <div class="container">
    <nav class="crumbs mono" aria-label="Kruimelpad">
      <a href="/tools">Tools</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{tool.pos}</span>
    </nav>

    <header class="intro">
      <div class="nr mono">Positie {tool.pos}</div>
      <h1>{name}</h1>
      <p class="lead">{description}</p>
    </header>

    <section class="split">
      <Figure src={src} alt={name} caption="Fig. 1 — Machine" size="tile" eager />
      <TitleBlock
        rows={[
          { label: 'Positie', value: tool.pos, accent: true },
          { label: 'Categorie', value: category },
        ]}
        tags={tags}
        links={usedIn.map((p) => ({ label: `${p.nr} ${p.data.title}`, href: `/projecten/${p.id}` }))}
        linksLabel="Gebruikt in"
      />
    </section>

    <article class="prose body">
      <Content />
    </article>

    <a href="/tools" class="back mono">← Terug naar de stuklijst</a>
  </div>
</Base>

<style>
  .crumbs { padding-top: 28px; font-size: 13px; color: var(--muted); display: flex; gap: 8px; }
  .crumbs a { color: var(--muted); }
  .crumbs [aria-current] { color: var(--ink); }
  .intro { padding: 40px 0 48px; }
  .nr { font-size: 13px; letter-spacing: 0.14em; color: var(--mark); }
  h1 { margin-top: 14px; font-size: clamp(3rem, 7vw, 5rem); line-height: 0.95; }
  .lead { max-width: 640px; margin-top: 22px; font-size: 20px; }
  .split { display: grid; grid-template-columns: auto minmax(280px, 420px); gap: 56px; align-items: start; }
  .body { padding-top: 88px; }
  .back { display: inline-block; margin-top: 88px; font-size: 13px; padding: 12px 0; }
  @media (max-width: 900px) { .split { grid-template-columns: minmax(0, 1fr); } }
</style>
