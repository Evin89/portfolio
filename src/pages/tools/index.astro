---
import Base from '../../layouts/Base.astro';
import ToolTable from '../../components/ToolTable.astro';
import { getTools } from '../../lib/content';

const tools = await getTools();
---

<Base title="Tools" description="Het machinepark van Evin — 3D printers, CNC en houtbewerking.">
  <section class="container head">
    <div class="kicker">Blad 03 · Stuklijst</div>
    <div class="title-row">
      <h1>Tools</h1>
      <span class="label count">{tools.length} machines</span>
    </div>
    <p class="lead">De machines in de werkplaats, met per machine de specs en waarvoor ik hem gebruik.</p>
  </section>

  <section class="container table">
    <ToolTable tools={tools} />
  </section>
</Base>

<style>
  .head { padding-top: 72px; }
  .title-row { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 16px; margin-top: 20px; }
  .count { font-size: 14px; }
  .lead { max-width: 560px; margin-top: 20px; font-size: 18px; }
  .table { padding-top: 48px; }
</style>
