---
import { formatShort, type Project } from '../lib/content';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, category, description, date, image } = project;
---

<a href={`/projecten/${project.id}`} class="card" data-category={category}>
  <div class="frame tile">
    {image ? <img src={image.src} alt="" width={image.width} height={image.height} loading="lazy" decoding="async" /> : <div class="tile-empty">Geen foto</div>}
    <span class="nr">{project.nr}</span>
  </div>
  <div class="meta mono">
    <span>{category}</span>
    <span>{formatShort(date)}</span>
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
</a>

<style>
  .card { display: flex; flex-direction: column; width: var(--tile); max-width: 100%; color: var(--ink); }
  .card:hover h3 { color: var(--mark); }
  .tile img { transition: filter 0.3s ease; }
  .card:hover .tile img { filter: brightness(1.08); }
  .nr {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 10px;
    background: var(--paper);
    border: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 20px;
    font-size: 12px;
    color: var(--muted);
  }
  h3 { margin-top: 10px; font-size: 1.65rem; line-height: 1.1; transition: color 0.2s; }
  p { margin-top: 10px; font-size: 15px; }
</style>
