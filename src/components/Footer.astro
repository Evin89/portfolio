---
const year = new Date().getFullYear();
---

<footer class="container">
  <div class="titleblock">
    <div class="cell wide">
      <div class="label">Werkplaats</div>
      <div class="brand">Builder Basement</div>
    </div>
    <div class="cell">
      <div class="label">Getekend</div>
      <div class="val">Evin Wijninga</div>
    </div>
    <div class="cell">
      <div class="label">Locatie</div>
      <div class="val">Rotterdam</div>
    </div>
    <div class="cell">
      <div class="label">Elders</div>
      <div class="val links">
        <a href="https://instagram.com/evin.makes" target="_blank" rel="noopener">Instagram ↗</a>
        <a href="https://reddit.com/u/evin_makes" target="_blank" rel="noopener">Reddit ↗</a>
      </div>
    </div>
  </div>
  <p class="copy mono">© {year} Evin Wijninga</p>
</footer>

<style>
  footer { padding-top: 120px; padding-bottom: 40px; }
  .titleblock {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    border: 2px solid var(--ink);
    font-size: 15px;
  }
  .cell { padding: 18px 22px; border-right: 1px solid var(--ink); }
  .cell:last-child { border-right: 0; }
  .label { font-size: 11px; letter-spacing: 0.12em; }
  .brand { margin-top: 4px; font-family: var(--font-display); font-size: 26px; }
  .val { margin-top: 6px; font-weight: 500; }
  .links { display: flex; flex-direction: column; gap: 2px; }
  .copy { margin-top: 16px; font-size: 11px; color: var(--muted); }

  @media (max-width: 800px) {
    .titleblock { grid-template-columns: 1fr 1fr; }
    .cell.wide { grid-column: 1 / -1; border-right: 0; border-bottom: 1px solid var(--ink); }
    .cell:nth-child(3) { border-right: 0; }
    .cell:nth-child(4) { grid-column: 1 / -1; border-top: 1px solid var(--ink); }
  }
</style>
